SECRET_KEY='secret_key'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=teamboard
POSTGRES_USER=teamboard
POSTGRES_PASSWORD='secure_password'
POSTGRES_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@teamboard.local
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

REFRESH_TOKEN_COOKIE_NAME=teamboard_refresh
REFRESH_TOKEN_COOKIE_PATH=/api/v1/accounts/
REFRESH_TOKEN_COOKIE_SECURE=False
REFRESH_TOKEN_COOKIE_SAMESITE=Lax
# Use a free local port if Windows reserves port 8000.
BACKEND_PORT=8000

# Host tools use loopback; Compose overrides these with the internal Redis host.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
EMAIL_TIMEOUT=15

CACHE_KEY_PREFIX=teamboard:development:v1:throttle
REDIS_PORT=6379
# Production SMTP: configure a real provider; never commit credentials.
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False

CHANNEL_REDIS_PREFIX=teamboard:development:v1:channels
